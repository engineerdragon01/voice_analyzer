# Required for the hybrid/gemini backends (paid-tier key: prompts/audio not used for training)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Max self-consistency samples per clip; the budget guard lowers it for short clips
GEMINI_SAMPLES=3
TARGET_COST_PER_MIN=0.0025
# Dashboard login
DASH_USER=autoace
DASH_PASS=
SESSION_SECRET=
# Storage + concurrency
DATA_DIR=./data/app
WORKERS=4
MAX_UPLOAD_MB=1024
# Set to 1 only for debugging; by default uploaded audio is deleted after analysis
KEEP_AUDIO=0
# Optional: keep audio inside your GCP project via Vertex AI instead of the Gemini Developer API
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
